<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dice-throne</AssemblyName>
    <RootNamespace>DiceThroneCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiceThroneApi\DiceThroneApi.csproj" />
    <Content Include="..\DiceThroneApi\Data\heroes\*.json" CopyToOutputDirectory="PreserveNewest" Link="Data\heroes\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
